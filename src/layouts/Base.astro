---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/montserrat-alternates/500.css';
import '@fontsource/montserrat-alternates/700.css';
import '../styles/global.css';
import PieDePagina from '../components/PieDePagina.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <slot />

    {/* Pie de página global (SPEC 09): montado una sola vez, tras <slot />,
        aparece en todas las páginas que usan Base. Va en flujo normal, antes
        del <dialog> overlay del visor de Guías (que no se ve afectado). */}
    <PieDePagina />

    {/* Visor global de Guías Rápidas (SPEC 08): un único <dialog> por página,
        reutilizado por todos los GuiaEnlace. Solo imagen (sin texto de paso),
        con zoom (+/−/reset), arrastre y cierre por X/backdrop/Esc. Arranca
        cerrado; sin JS ningún GuiaEnlace lo abre (degradación limpia). */}
    <dialog id="guia-modal" class="guia-modal" aria-label="Visor de guía">
      <div class="guia-modal__lienzo" data-guia-lienzo>
        <img data-guia-img alt="" draggable="false" class="guia-modal__img" />
      </div>

      <div class="guia-modal__controles" role="toolbar" aria-label="Controles del visor">
        <button type="button" data-guia-zoom-out aria-label="Alejar" class="guia-modal__btn">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14" />
          </svg>
        </button>
        <button type="button" data-guia-reset aria-label="Restablecer tamaño" class="guia-modal__btn">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 9V4.5M9 9H4.5M9 9 3.75 3.75M9 15v4.5M9 15H4.5M9 15l-5.25 5.25M15 9h4.5M15 9V4.5M15 9l5.25-5.25M15 15h4.5M15 15v4.5m0-4.5 5.25 5.25" />
          </svg>
        </button>
        <button type="button" data-guia-zoom-in aria-label="Acercar" class="guia-modal__btn">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" />
          </svg>
        </button>
        <button type="button" data-guia-close aria-label="Cerrar visor" class="guia-modal__btn guia-modal__btn--close">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </dialog>

    <script>
      import '../scripts/guia-modal.ts';
    </script>

    <style is:global>
      .guia-modal {
        width: 100vw;
        height: 100dvh;
        max-width: 100vw;
        max-height: 100dvh;
        margin: 0;
        padding: 0;
        border: none;
        background: transparent;
        overflow: hidden;
      }
      .guia-modal::backdrop {
        background: oklch(20% 0.03 249.8 / 0.9);
      }
      .guia-modal[open] {
        display: flex;
      }
      .guia-modal__lienzo {
        display: flex;
        flex: 1;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }
      .guia-modal__img {
        max-width: 100vw;
        max-height: 100dvh;
        object-fit: contain;
        transform-origin: center center;
        will-change: transform;
        user-select: none;
        cursor: grab;
        touch-action: none;
      }
      .guia-modal__img[data-arrastrando='true'] {
        cursor: grabbing;
      }
      .guia-modal__controles {
        position: fixed;
        bottom: 1.25rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.375rem;
        border-radius: 9999px;
        background: oklch(27.8% 0.056 249.8 / 0.92);
        box-shadow: 0 8px 24px oklch(0% 0 0 / 0.35);
      }
      .guia-modal__btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 9999px;
        color: oklch(96.9% 0.007 106.5);
        transition: background-color 0.15s ease;
      }
      .guia-modal__btn:hover {
        background: oklch(100% 0 0 / 0.12);
      }
      .guia-modal__btn:focus-visible {
        outline: 2px solid var(--gold);
        outline-offset: 2px;
      }
      .guia-modal__btn--close {
        margin-left: 0.25rem;
        color: var(--gold);
      }
      @media (prefers-reduced-motion: reduce) {
        .guia-modal__img {
          will-change: auto;
        }
      }
    </style>
  </body>
</html>
