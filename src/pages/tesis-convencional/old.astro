---
// Página del proceso de Tesis por reglamento anterior, para egresados que iniciaron su
// trámite antes del 16 de marzo de 2026 y a quienes les rigen las tasas vigentes antes
// de esa fecha.
// Réplica del shell de `tesis-convencional.astro`: SOLO compone, pero lee las
// etapas de la collection propia `etapasTesisOld` (carpeta etapas-tesis-old/).
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EncabezadoProceso from '../../components/proceso/EncabezadoProceso.astro';
import RielProceso from '../../components/proceso/RielProceso.astro';
import EtapaArticulo from '../../components/proceso/EtapaArticulo.astro';

// getCollection NO garantiza orden → ordenar por `orden` (igual que la página vigente).
const etapas = (await getCollection('etapasTesisOld')).sort(
  (a, b) => a.data.orden - b.data.orden,
);

// Renderizar el cuerpo MDX de cada etapa para poder envolverlo en EtapaArticulo.
const etapasRender = await Promise.all(
  etapas.map(async (etapa) => ({
    id: etapa.id,
    data: etapa.data,
    Content: (await render(etapa)).Content,
  })),
);

// Datos que el riel necesita (nombre real por etapa) + etapa activa inicial.
const rielEtapas = etapasRender.map((e) => ({ id: e.id, titulo: e.data.titulo }));
const activaId = etapasRender[0]?.id ?? '';
---

<Base
  title="Tesis (reglamento anterior) — Titulación FADE-UPT"
  description="Guía del proceso de titulación por tesis para egresados de la Facultad de Derecho y Ciencias Políticas de la UPT que iniciaron su trámite antes del 16 de marzo de 2026, a quienes les rigen las tasas vigentes antes de esa fecha."
>
  <main class="mx-auto max-w-4xl px-4 py-12 sm:py-16">
    <EncabezadoProceso
      titulo="Tesis"
      descripcion="Si iniciaste tu trámite de titulación antes del 16 de marzo de 2026, te rigen las tasas vigentes antes de esa fecha. Recorre aquí cada etapa de ese proceso, con los documentos que preparas, el pago cuando corresponde y el trámite único que envías por Mesa de Partes Virtual."
      volverHref="/"
    >
      <p slot="aviso">
        ¿Iniciaste tu trámite desde el <strong class="font-medium text-foreground">16 de marzo de 2026</strong>?{' '}
        <a
          href="/tesis-convencional"
          class="font-medium text-gold-strong underline underline-offset-2 hover:no-underline"
        >
          Ve al proceso vigente
        </a>.
      </p>
    </EncabezadoProceso>

    <div class="flex flex-col gap-10 md:flex-row md:gap-8">
      <div class="hidden md:block md:w-56 md:flex-shrink-0">
        <RielProceso etapas={rielEtapas} activaId={activaId} />
      </div>

      <div class="flex-grow md:max-w-3xl">
        {
          etapasRender.map((etapa, i) => (
            <EtapaArticulo
              id={etapa.id}
              titulo={etapa.data.titulo}
              estado={etapa.data.estado}
              plantillas={etapa.data.plantillas}
              esPrimera={i === 0}
              esUltima={i === etapasRender.length - 1}
              activa={etapa.id === activaId}
            >
              <etapa.Content />
            </EtapaArticulo>
          ))
        }
      </div>
    </div>
  </main>

  <script>
    import '../../scripts/proceso-swap.ts';
  </script>
</Base>
