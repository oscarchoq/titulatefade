---
// Recuadro con los datos del trámite de una etapa: costo y tasa (si aplica) +
// destinatario/tipo/asunto del trámite. Prop-driven y genérico (sirve a cualquier
// proceso). Solo se renderiza si recibe datos de trámite. Los valores de dato
// (costo, código) van en font-mono (DESIGN_BRIEF: Geist Mono para datos).
interface Tramite {
  destinatario: string;
  tipo: string;
  asunto: string;
}

interface Props {
  costo?: string;
  codigoTasa?: string;
  conceptoTasa?: string;
  tramite?: Tramite;
}

const { costo, codigoTasa, conceptoTasa, tramite } = Astro.props;

// Si no hay ni tasa ni trámite, no se renderiza nada (guard en el template).
const hayTasa = Boolean(costo || codigoTasa || conceptoTasa);
---

{
  (hayTasa || tramite) && (
    <div class="my-6 rounded-lg border border-border bg-secondary p-5">
      {hayTasa && (
        <div class="flex flex-wrap items-baseline gap-x-6 gap-y-2 border-b border-border pb-4">
          {costo && (
            <div>
              <span class="block text-xs font-medium tracking-wide text-muted-foreground uppercase">Costo</span>
              <span class="font-mono text-lg font-semibold text-foreground">{costo}</span>
            </div>
          )}
          {codigoTasa && (
            <div>
              <span class="block text-xs font-medium tracking-wide text-muted-foreground uppercase">Código de tasa</span>
              <span class="font-mono text-lg font-semibold text-foreground">{codigoTasa}</span>
            </div>
          )}
          {conceptoTasa && (
            <div class="min-w-0">
              <span class="block text-xs font-medium tracking-wide text-muted-foreground uppercase">Concepto</span>
              <span class="text-sm text-foreground">{conceptoTasa}</span>
            </div>
          )}
        </div>
      )}

      {tramite && (
        <dl class={`grid gap-3 text-sm ${hayTasa ? 'pt-4' : ''}`}>
          <div class="flex flex-col gap-0.5 sm:flex-row sm:gap-3">
            <dt class="w-32 shrink-0 font-medium text-muted-foreground">Destinatario</dt>
            <dd class="text-foreground">{tramite.destinatario}</dd>
          </div>
          <div class="flex flex-col gap-0.5 sm:flex-row sm:gap-3">
            <dt class="w-32 shrink-0 font-medium text-muted-foreground">Tipo de trámite</dt>
            <dd class="text-foreground">{tramite.tipo}</dd>
          </div>
          <div class="flex flex-col gap-0.5 sm:flex-row sm:gap-3">
            <dt class="w-32 shrink-0 font-medium text-muted-foreground">Asunto</dt>
            <dd class="text-foreground">{tramite.asunto}</dd>
          </div>
        </dl>
      )}
    </div>
  )
}
