---
// Encabezado de una página de proceso. Genérico y prop-driven, sin copy
// hardcodeado: enlace "Regresar" + título + descripción llegan por props.
//
// La descripción admite dos formas (SPEC 13/14), retrocompatibles entre sí:
//   1. prop `descripcion: string` — texto plano, sin formato.
//   2. slot `descripcion` — para negritas/enlaces; se usa vía
//      <Fragment slot="descripcion">…</Fragment> porque este componente ya
//      envuelve el contenido en <p>. Si se provee el slot, reemplaza al prop.
interface Props {
  titulo: string;
  descripcion?: string; // opcional: puede llegar por el slot `descripcion` con formato
  volverHref?: string;
}

const { titulo, descripcion = '', volverHref = '/' } = Astro.props;

// Slot opcional para un aviso (p. ej. enlace de derivación a otro proceso).
// Si no se provee contenido, el encabezado se ve idéntico a antes.
const tieneAviso = Astro.slots.has('aviso');

// Slot opcional para la descripción con formato (negritas, enlaces). Si se
// provee, reemplaza al prop `descripcion`; si no, se usa el string plano. Así
// las páginas existentes siguen funcionando sin cambios.
const tieneDescripcion = Astro.slots.has('descripcion');
---

<header class="mb-10">
  <a
    href={volverHref}
    class="group -ml-2 inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      class="size-4 transition-transform group-hover:-translate-x-0.5"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
    </svg>
    Regresar
  </a>

  <h1 class="mt-6 font-display text-4xl font-bold text-foreground sm:text-5xl">
    {titulo}
  </h1>
  <p class="mt-4 text-base text-muted-foreground">
    {tieneDescripcion ? <slot name="descripcion" /> : descripcion}
  </p>

  {
    tieneAviso && (
      <div class="mt-5 rounded-lg border border-border bg-muted/40 px-4 py-3 text-sm text-muted-foreground">
        <slot name="aviso" />
      </div>
    )
  }

  <hr class="mt-8 border-t border-border" />
</header>
