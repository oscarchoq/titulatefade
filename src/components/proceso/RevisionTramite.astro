---
interface Props {
  imagen: string;
}

const { imagen } = Astro.props;
---

<p>
  Antes de enviarlo, <button
  type="button"
  data-guia
  data-guia-src={imagen}
  data-guia-alt="Ejemplo del trámite antes de enviarlo"
  aria-haspopup="dialog"
  class="cursor-pointer rounded-sm bg-transparent p-0 text-left font-medium text-gold-strong underline decoration-gold-strong/40 underline-offset-2 transition-colors hover:decoration-gold-strong active:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
>
  mira este ejemplo del trámite <span class="whitespace-nowrap">completo<svg class="ml-1 inline-block size-4 align-[-0.125em]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="3" width="18" height="18" rx="2" />
    <circle cx="8.5" cy="8.5" r="1.5" />
    <path d="m21 15-5-5L5 21" />
  </svg></span></button>.
</p>
